#!/bin/sh

# Make sure Python trusts the local Certificate Authority.
export SSL_CERT_FILE=/etc/tt/certs/tt-fullchain.pem

# Use websockify to translate WebSockets on port 9006 to TLS on port 9005.
websockify 9006 localhost:9005 \
  -v \
  --ssl-target \
  --ssl-only \
  --cert=/etc/tt/certs/tt-public.pem \
  --key=/etc/tt/certs/tt-private.pem
