#!/bin/sh

# Change to the Tandem Tales directory.
cd /opt/tt

# Start the server.
echo "Starting Tandem Tales server..."
java \
  -Djavax.net.ssl.keyStore="/etc/tt/certs/tt-keystore.p12" \
  -Djavax.net.ssl.keyStorePassword="changeit" \
  -jar tt-server.jar \
  -logs /var/log/tt/logs \
  -status /var/log/tt/status.json \
  -sessions /var/log/tt/sessions \
  -database database.json \
  -p 9005
