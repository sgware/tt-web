#!/bin/sh

# Change to the Tandem Tales directory.
cd /opt/tt
# If agent details appear in environment variables, add the agent to the database.
if [ -n "$name" ]; then
  command="add agent $name\n"
  if [ -n "$password" ]; then
    command="${command}set agent $name password $password\n"
  fi
  if [ -n "$title" ]; then
    command="${command}set agent $name title $title\n"
  fi
  if [ -n "$description" ]; then
    command="${command}set agent $name description $description\n"
  fi
  command="${command}list agent $name\n"
  echo "\ncommand:\n$command\n"
  echo "$command" | /usr/local/bin/start_tt_foreground
else
  /usr/local/bin/start_tt_foreground
fi
