#!/bin/sh

# Import public and private SSL keys into a Java-compatible keystore.
echo "Importing private and public keys into Java keystore..."
openssl pkcs12 -export \
  -in /etc/tt/certs/tt-fullchain.pem \
  -inkey /etc/tt/certs/tt-private.pem \
  -out /etc/tt/certs/tt-keystore.p12 \
  -name tt \
  -caname root \
  -passout pass:changeit

echo "Importing public key into Java truststore..."
# Start with the standard trust store.
keytool \
  -importkeystore \
	-srckeystore /usr/lib/jvm/java-25-openjdk-amd64/lib/security/cacerts \
	-srcstoretype JKS \
	-srcstorepass "changeit" \
	-destkeystore /etc/tt/certs/tt-truststore.p12 \
	-deststoretype PKCS12 \
	-deststorepass "changeit"
# Import public SSL key into a Java-compatible trust store.
keytool \
  -importcert \
  -file /etc/tt/certs/tt-fullchain.pem \
  -keystore /etc/tt/certs/tt-truststore.p12 \
  -storetype PKCS12 \
  -storepass "changeit" \
  -alias "tt" \
  -noprompt